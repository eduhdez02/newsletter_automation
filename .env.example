# Copia este archivo a .env y rellena tus credenciales reales.
# En GitHub Actions, estas mismas claves se configuran como Secrets del repo.

# --- IA (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
# Solo si tu key NO está ligada a un workspace específico (ver Console ->
# Settings -> Workspaces -> columna ID). Si tu key ya es de un solo
# workspace, deja esto vacío.
ANTHROPIC_WORKSPACE_ID=

# --- SMTP / correo saliente ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=DAUCH

# --- Destinatarios ---
# RECEIVERS solo se usa en modo --full (envío real, vía el cron programado).
RECEIVERS=
# TEST_RECIPIENT se usa en modo --test (pruebas manuales).
TEST_RECIPIENT=eduardohernandez@dauch.com.mx

SUBJECT_PREFIX=DAUCH — Novedades del sector geoespacial
